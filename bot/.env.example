# Пример настроек. Скопируй в .env (установщик делает это сам) и заполни.
# .env никогда не коммитится — см. .gitignore

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token
ADMIN_IDS=111111111

# --- Каналы ---
OF_IMAGE=openflux-exit:local
MAX_CHANNELS=4
CHANNEL_MEM=128m
CHANNEL_CPUS=0.3
STARTUP_WAIT=10
ARGS_YANDEX=--role=exit --transport=yandex --url {url}
ARGS_MAILRU=--role=exit --transport=mailru --url {url}
ARGS_VYANDEX=--role=exit --transport=vyandex --url {url}
ARGS_BOARDS=--role=exit --transport=boards --url {url}

# --- Мониторинг сервера ---
DISK_ALERT_PCT=85
MEM_ALERT_PCT=90

# --- Клиенты: "Название|url;Название|url" (пусто = ссылки p1neappleXpress) ---
CLIENT_LINKS=

# --- Секрет канала ---
# ask — пользователь выбирает кнопкой; always — всегда с секретом; never — всегда без
SECRET_CHOICE=ask
# generate — бот генерирует секрет, канал получает --encryption-key-file
SECRET_METHOD=generate
# /give без аргумента: secret | nosecret
SECRET_DEFAULT=secret
# пусто = через --encryption-key-file (рекомендуется)
SECRET_ARG=

# --- Формат конфига ---
# openflux-v1 — ссылка openflux://v1/... (по умолчанию); template — строка по CONFIG_TEMPLATE
CONFIG_FORMAT=openflux-v1
# имя профиля в клиенте: {id} {tg_id} {transport}
CONFIG_NAME=OpenFlux {id}
TYPE_YANDEX=yandex
TYPE_MAILRU=mailru
TYPE_VYANDEX=vyandex
TYPE_BOARDS=boards
# Yandex Volga (ссылки https://docs.yandex.ru/edit/d/...):
#   off  — только вручную: /give <tg_id> <url> vyandex
#   auto — такие ссылки от пользователей сразу идут в vyandex
#         (раньше их получал транспорт yandex — включайте, только если проверили на своём узле)
VYANDEX_MODE=off

# --- Прямое TCP-подключение (/direct), без документа ---
# Публичный адрес этого сервера (IP или домен). Пусто — прямые каналы выключены.
# Адрес узла в этом режиме виден, поэтому канал не маскируется; ключ шифрования обязателен.
PUBLIC_HOST=
# Порты, которые бот публикует под прямые каналы (по одному на канал)
DIRECT_PORT_MIN=20000
DIRECT_PORT_MAX=20999
ARGS_DIRECT=--role=exit --negotiate --transports=direct:50 --direct-listen=0.0.0.0:{port}

# --- Cups.online (/cups), без документа ---
# Узел сам создаёт комнаты при старте и печатает их список; бот кладёт список в профиль.
# Серверу нужен доступ к interview.cups.online. 0 — команда /cups и /give <id> cups выключены.
CUPS_ENABLED=1
# сколько секунд ждать список комнат в логе узла
CUPS_TIMEOUT=90
# Клиент OpenFlux старее 0.7.1 (например, приложение на телефоне не обновлено) не читает новый список комнат.
# Поставьте 0 — узлы Cups будут работать по-старому, и такой клиент подключится. Пусто — как по умолчанию в OpenFlux.
# Действует на новые каналы /cups; уже работающий канал нужно удалить и создать заново.
CUPS_STRIPE=
TYPE_CUPS=cupsonline
ARGS_CUPS=--role=exit --transport=cupsonline
QR_ENABLED=1
# только для CONFIG_FORMAT=template
CONFIG_TEMPLATE=openflux://?transport={transport}&url={url_enc}&name={name}
CONFIG_TEMPLATE_SECRET=
